# Required Telegram bot credential from @BotFather.
BOT_TOKEN=replace-with-bot-token

# Required database secret used by Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required only when the bundled local Telegram Bot API service is enabled.
TELEGRAM_API_ID=replace-with-api-id
TELEGRAM_API_HASH=replace-with-api-hash
CUSTOM_API_URL=http://telegram-bot-api:8081
YOUTUBE_POT_PROVIDER_URL=http://youtube-pot-provider:4416

# Optional runtime settings.
UX_SELECTION_FLOW=true
YTDLP_RESOLVE_TIMEOUT_SECONDS=120
WORKER_REPLICAS=1
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
SPOTIFY_BITRATE=320

# Optional cookie broker profile. Never commit the corresponding secret file.
BROKER_URL=https://example.invalid
BROKER_USERNAME=downloader-bot
COOKIE_BROKER_IMAGE=replace-with-cookie-broker-image
